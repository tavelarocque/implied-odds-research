<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rebuilds data/dashboard/data.js for dashboard/index.html every 15 minutes while the Mac is awake.
     Read-only: fetches the data branch and public prices; places no trade and dispatches no workflow. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tave.impliedodds.dashboard</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string>
    <string>cd "$HOME/CODE/implied-odds" &amp;&amp; PYTHONPATH=. .venv/bin/python trade/dashboard.py</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/impliedodds_dashboard.log</string>
  <key>StandardErrorPath</key><string>/tmp/impliedodds_dashboard.log</string>
</dict>
</plist>
